        int l = 0; while (t[l]) l++;
        gfx_puts((W - l*8) / 2, cy - 4, t, 0xFFFFFF, 1);
    }

    /* Правый угол */
    extern volatile uint32_t ticks;
    uint32_t secs = ticks / 100;
    uint32_t hh = (secs / 3600) % 24;
    uint32_t mm = (secs / 60) % 60;

    /* Иконки: батарея, wifi, поиск */
    int ix = W - 130;

    /* Battery */
    gfx_box(ix, cy - 6, 22, 12, 0xFFFFFF);
    gfx_box_fill(ix + 2, cy - 4, 16, 8, 0x40D040);
    gfx_box_fill(ix + 22, cy - 3, 2, 6, 0xFFFFFF);

    /* WiFi дуги */
    ix += 32;
    for (int r = 3; r <= 8; r += 2) {
        for (int a = 210; a <= 330; a += 2) {
            int px = ix + (r * 10) / 10 * 1;
