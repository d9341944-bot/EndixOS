static void draw_topbar(void) {
    int W = (int)fb_width();
    int H = 28;

    /* Фон — блендинг с обоями (полупрозрачность) */
    for (int y = 0; y < H; y++) {
        for (int x = 0; x < W; x++) {
            uint32_t bg = fb_getpixel(x, y);
            uint32_t br = ((bg >> 16) & 0xFF);
            uint32_t bgc = ((bg >> 8) & 0xFF);
            uint32_t bb = (bg & 0xFF);

            /* Смешиваем 25% обоев + 75% тёмного (сильнее blur) */
            br = (br * 25 + 15 * 75) / 100;
            bgc = (bgc * 25 + 15 * 75) / 100;
            bb = (bb * 25 + 20 * 75) / 100;
            if (br > 255) br = 255;
            if (bgc > 255) bgc = 255;
            if (bb > 255) bb = 255;
            fb_putpixel(x, y, (br << 16) | (bgc << 8) | bb);
        }
    }

    int cy = H / 2;

    /* Яблоко (логотип-круг) */
    int lx = 16;
    for (int dy = -5; dy <= 5; dy++)
        for (int dx = -5; dx <= 5; dx++)
