        for (int dx = -3; dx <= 3; dx++)
            if (dx*dx + dy*dy <= 9)
                fb_putpixel(ix + dx, cy + dy + 3, 0xFFFFFF);

    /* Search */
    ix += 22;
    for (int r = 4; r <= 6; r++) {
        for (int a = 0; a < 360; a += 10) {
            /* не считаем cos/sin — рисуем круг вручную */
        }
    }
    for (int dy = -5; dy <= 5; dy++)
        for (int dx = -5; dx <= 5; dx++) {
            int d2 = dx*dx + dy*dy;
            if (d2 >= 16 && d2 <= 25)
